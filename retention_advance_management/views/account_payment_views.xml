<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Account Payment Form View Inheritance -->
    <record id="view_account_payment_form_inherit_advance" model="ir.ui.view">
        <field name="name">account.payment.form.inherit.advance</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group1']" position="inside">
                <field name="is_advance_payment" readonly="state != 'draft'"/>
                <field name="sale_order_id" invisible="not is_advance_payment" readonly="state != 'draft'" options="{'no_create': True}"/>
                <field name="advance_remaining_amount" invisible="not is_advance_payment or state != 'paid'"/>
                <field name="advance_recovered_amount" invisible="not is_advance_payment or state != 'paid'"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <notebook invisible="not is_advance_payment or state != 'paid'">
                    <page string="Advance Recoveries" name="advance_recoveries_page">
                        <field name="advance_recovery_ids" readonly="1">
                            <list>
                                <field name="name"/>
                                <field name="date"/>
                                <field name="move_id" string="Invoice / Credit Note"/>
                                <field name="recovery_type"/>
                                <field name="amount"/>
                                <field name="currency_id" column_invisible="True"/>
                                <field name="state" widget="badge"/>
                            </list>
                        </field>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>

    <!-- Account Payment Tree View Inheritance -->
    <record id="view_account_payment_tree_inherit_advance" model="ir.ui.view">
        <field name="name">account.payment.list.inherit.advance</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="before">
                <field name="is_advance_payment" optional="show"/>
                <field name="advance_remaining_amount" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
