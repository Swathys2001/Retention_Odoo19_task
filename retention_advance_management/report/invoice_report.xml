<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_document_inherit_retention" inherit_id="account.report_invoice_document">
        <!-- Add Expected Handover Date in Information Block -->
        <xpath expr="//div[@id='informations']" position="inside">
            <div class="col" t-if="o.expected_retention_handover_date and o.retention_amount > 0" name="expected_retention_date">
                <strong>Retention Handover:</strong>
                <div t-field="o.expected_retention_handover_date"/>
            </div>
        </xpath>

        <!-- Replace payments widget in totals table: display deductions and final amount cleanly without duplicate payment lines -->
        <xpath expr="//table[hasclass('o_total_table')]//t[@t-if='print_with_payments']" position="replace">
            <t t-if="o.retention_amount > 0 or o.advance_recovery_amount > 0">
                <tr t-if="o.retention_amount > 0" class="text-muted">
                    <td>
                        <span>Less Retention (<t t-out="'%.2f' % o.retention_percentage"/>%)</span>
                        <t t-if="o.expected_retention_handover_date">
                            <br/><small class="text-muted">Expected Release: <span t-field="o.expected_retention_handover_date"/></small>
                        </t>
                    </td>
                    <td class="text-end text-nowrap">
                        - <span t-field="o.retention_amount"/>
                    </td>
                </tr>
                <tr t-if="o.advance_recovery_amount > 0" class="text-muted">
                    <td>
                        <span>Less Advance Recovery (<t t-if="o.advance_recovery_method == 'percentage'"><t t-out="'%.2f' % o.advance_recovery_percentage"/>%</t><t t-else="">Fixed</t>)</span>
                    </td>
                    <td class="text-end text-nowrap">
                        - <span t-field="o.advance_recovery_amount"/>
                    </td>
                </tr>
                <tr class="fw-bold" style="border-top: 1px solid #212529;">
                    <td>
                        <strong>Amount Payable Now</strong>
                    </td>
                    <td class="text-end text-nowrap">
                        <span t-field="o.amount_payable_immediately"/>
                    </td>
                </tr>
            </t>
            <t t-else="">
                <t t-if="print_with_payments">
                    <t t-if="o.payment_state != 'invoicing_legacy'">
                        <t t-set="payments_vals" t-value="o.sudo().invoice_payments_widget and o.sudo().invoice_payments_widget['content'] or []"/>
                        <t t-foreach="payments_vals" t-as="payment_vals">
                            <tr t-if="payment_vals['is_exchange'] == 0">
                                <td>
                                    <i class="oe_form_field text-end oe_payment_label">
                                        <t t-if="payment_vals['is_refund']">Reversed on </t>
                                        <t t-else="">Paid on </t>
                                        <t t-out="payment_vals['date']" t-options='{"widget": "date"}'>2021-09-19</t>
                                    </i>
                                </td>
                                <td class="text-end">
                                    <span t-out="payment_vals['amount']" t-options='{"widget": "monetary", "display_currency": o.currency_id}'>20.00</span>
                                </td>
                            </tr>
                        </t>
                        <t t-if="len(payments_vals) > 0">
                            <tr class="fw-bold">
                                <td>Amount Due</td>
                                <td class="text-end">
                                    <span t-field="o.amount_residual">11.05</span>
                                </td>
                            </tr>
                        </t>
                    </t>
                </t>
            </t>
        </xpath>
    </template>
</odoo>
